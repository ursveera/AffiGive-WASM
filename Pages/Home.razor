@page "/home"

<PageTitle>Home - AffiGive Dashboard</PageTitle>

<div class="page-header mb-5">
    <h1 class="display-4 fw-bold mb-2">👋 Welcome to AffiGive</h1>
    <p class="lead text-muted">Your premium dashboard for managing gifts, users, and campaigns</p>
</div>

<div class="dashboard-grid">
    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card premium-card shadow-lg">
                <div class="stat-icon">🎁</div>
                <div class="stat-content">
                    <h6 class="text-muted">Total Gifts</h6>
                    <p class="stat-value">Manage</p>
                </div>
                <a href="/admin/gifts" class="stat-link">View Gifts →</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card premium-card shadow-lg">
                <div class="stat-icon">👥</div>
                <div class="stat-content">
                    <h6 class="text-muted">Total Users</h6>
                    <p class="stat-value">Manage</p>
                </div>
                <a href="/admin/users" class="stat-link">View Users →</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card premium-card shadow-lg">
                <div class="stat-icon">🎥</div>
                <div class="stat-content">
                    <h6 class="text-muted">Videos</h6>
                    <p class="stat-value">Manage</p>
                </div>
                <a href="/admin/videos" class="stat-link">View Videos →</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card premium-card shadow-lg">
                <div class="stat-icon">🏆</div>
                <div class="stat-content">
                    <h6 class="text-muted">Winners</h6>
                    <p class="stat-value">Manage</p>
                </div>
                <a href="/admin/winners" class="stat-link">View Winners →</a>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">
        <!-- Welcome Section -->
        <div class="col-lg-8">
            <div class="card premium-card shadow-lg border-0">
                <div class="card-header premium-header">
                    <h5 class="mb-0">🚀 Getting Started</h5>
                </div>

                <div class="card-body p-4">
                    <p class="lead mb-4">
                        Welcome to your AffiGive admin dashboard! Here's what you can do:
                    </p>

                    <div class="feature-list">
                        <div class="feature-item">
                            <div class="feature-icon">📋</div>
                            <div class="feature-content">
                                <h6 class="fw-bold">Manage Gifts</h6>
                                <p class="text-muted small">Create, edit, and manage gift campaigns with participants</p>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">👤</div>
                            <div class="feature-content">
                                <h6 class="fw-bold">User Management</h6>
                                <p class="text-muted small">View user details, rankings, and manage account deletions</p>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">🎬</div>
                            <div class="feature-content">
                                <h6 class="fw-bold">Video Management</h6>
                                <p class="text-muted small">Upload and manage videos for your campaigns</p>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">🎊</div>
                            <div class="feature-content">
                                <h6 class="fw-bold">Winner Selection</h6>
                                <p class="text-muted small">Pick winners and manage monthly rankings</p>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">📢</div>
                            <div class="feature-content">
                                <h6 class="fw-bold">Notifications</h6>
                                <p class="text-muted small">Send notifications and manage system alerts</p>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">❓</div>
                            <div class="feature-content">
                                <h6 class="fw-bold">FAQ Management</h6>
                                <p class="text-muted small">Create and maintain frequently asked questions</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Sidebar -->
        <div class="col-lg-4">
            <div class="card premium-card shadow-lg border-0 mb-4">
                <div class="card-header premium-header">
                    <h5 class="mb-0">⚡ Quick Actions</h5>
                </div>

                <div class="card-body p-3">
                    <div class="d-flex flex-column gap-2">
                        <a href="/admin/gifts" class="btn btn-premium-primary">
                            <span class="btn-icon">🎁</span> Create Gift
                        </a>
                        <a href="/admin/videos" class="btn btn-premium-secondary">
                            <span class="btn-icon">🎥</span> Add Video
                        </a>
                        <a href="/admin/notifications" class="btn btn-premium-secondary">
                            <span class="btn-icon">📢</span> Send Notification
                        </a>
                        <a href="/admin/winners" class="btn btn-premium-secondary">
                            <span class="btn-icon">🏆</span> Pick Winner
                        </a>
                        <a href="/admin/faqs" class="btn btn-premium-secondary">
                            <span class="btn-icon">❓</span> Manage FAQ
                        </a>
                    </div>
                </div>
            </div>

            <div class="card premium-card shadow-lg border-0">
                <div class="card-header premium-header">
                    <h5 class="mb-0">ℹ️ System Info</h5>
                </div>

                <div class="card-body p-4">
                    <div class="system-info">
                        <div class="info-row">
                            <span class="info-label">Version</span>
                            <span class="info-value">1.0.0</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Status</span>
                            <span class="info-value"><span class="badge bg-success">Online</span></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Database</span>
                            <span class="info-value"><span class="badge bg-info">Connected</span></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">API</span>
                            <span class="info-value"><span class="badge bg-success">Active</span></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

