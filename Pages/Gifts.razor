@page "/admin/gifts"
@using SharedLib.DTO
@using SharedLib.Models
@using WASM.api
@inject IGiftApi GiftApi
@inject NavigationManager Nav

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold mb-2">🎁 Gift Manager</h1>
    <p class="text-muted">Manage and configure your gift campaigns</p>
</div>

<div class="search-container mb-4">
    <input class="form-control form-control-lg premium-input"
           placeholder="🔍 Search by provider or prize pool..."
           @bind="searchText"
           @bind:event="oninput" />
</div>

<div class="card premium-card shadow-lg border-0">
    <div class="card-header premium-header">
        <h5 class="mb-0">📋 Gift List</h5>
    </div>

    <div class="table-responsive premium-table-container">
        <table class="table premium-table align-middle mb-0">
            <thead>
                <tr>
                    <th @onclick="() => SortBy(nameof(GiftMaster.Provider))" class="sortable">Provider</th>
                    <th>Image</th>
                    <th>Prize Pool</th>
                    <th>Winners</th>
                    <th>Coins</th>
                    <th>Slots</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Ends</th>
                    <th>Code</th>
                    <th>Active</th>
                    <th>Is From Entry</th>
                    <th>Winner Lock</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!filteredGifts.Any())
                {
                    <tr class="empty-state">
                        <td colspan="14" class="text-center py-5">
                            <div class="empty-state-icon mb-3">🚫</div>
                            <p class="text-muted fs-6">No gifts found</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var gift in filteredGifts)
                    {
                        <tr class="premium-row">
                            <td>
                                <span class="badge bg-gradient-primary">@gift.Provider</span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(gift.Image))
                                {
                                    <img src="@gift.Image"
                                         class="gift-image"
                                         alt="@gift.Provider" />
                                }
                            </td>

                            <td><span class="fw-semibold">@gift.PrizePoolText</span></td>
                            <td><span class="fw-semibold">@gift.WinnerText</span></td>

                            <td>
                                <span class="badge bg-gradient-success coins-badge">@gift.CoinsRequired</span>
                            </td>

                            <td>
                                <span class="badge bg-gradient-info slots-badge">
                                    @gift.RemainingSlots / @gift.TotalSlots
                                </span>
                            </td>
                            <td class="date-cell">@gift.FromDate.ToString("dd MMM yyyy")</td>

                            <td class="date-cell">@gift.ToDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @GetEndsBadge(gift.ToDate) ends-badge">
                                    @GetEndsText(gift.ToDate)
                                </span>
                            </td>
                            <td>
                                <code class="code-badge">@gift.Code</code>
                            </td>

                            <td>
                                <span class="status-badge @(gift.IsActive ? "active" : "inactive")">
                                    @(gift.IsActive ? "✓ Active" : "✗ Inactive")
                                </span>
                            </td>
                            <td>
                                <span class="status-badge @(gift.isFromEntry ? "active" : "inactive")">
                                    @(gift.isFromEntry ? "✓ Yes" : "✗ No")
                                </span>
                            </td>
                            <td>
                                <span class="status-badge @(gift.WinnersLocked ? "locked" : "unlocked")">
                                    @(gift.WinnersLocked ? "🔒 Locked" : "🔓 Open")
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="btn-group-vertical btn-group-sm w-100">
                                    <div class="d-flex justify-content-end gap-2 mb-2">
                                        <button class="btn btn-sm btn-icon-info"
                                                title="Joined Participants"
                                                @onclick="() => ViewParticipants(gift.Id)">
                                            👥
                                        </button>

                                        @if (!gift.WinnersLocked)
                                        {
                                            <button class="btn btn-sm btn-icon-success"
                                                    title="Lock Winners"
                                                    disabled="@isLocking"
                                                    @onclick="() => LockWinners(gift.Id, gift.isFromEntry, gift.Code)">
                                                🏆
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-icon-warning"
                                                    title="Unlock Winners"
                                                    disabled="@isLocking"
                                                    @onclick="() => UnlockWinners(gift.Id)">
                                                🔓
                                            </button>
                                        }

                                        <button class="btn btn-sm btn-icon-dark"
                                                title="View Winners"
                                                @onclick="() => ViewWinners(gift.Id)">
                                            👁
                                        </button>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm btn-icon-primary"
                                                title="Edit Gift"
                                                @onclick="() => EditGift(gift)">
                                            ✏️
                                        </button>

                                        <button class="btn btn-sm btn-icon-danger"
                                                title="Delete Gift"
                                                @onclick="() => DeleteGift(gift.Id)">
                                            🗑
                                        </button>

                                        <button class="btn btn-sm btn-icon-dark-danger"
                                                title="Force Delete (Permanent)"
                                                @onclick="() => PrepareForceDelete(gift.Id)">
                                            💀
                                        </button>
                                    </div>
                                </div>
                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card premium-card shadow-lg border-0 mt-5">
    <div class="card-header premium-header">
        <h5 class="mb-0">@(isEditMode ? "✏️ Edit Gift" : "➕ Create Gift")</h5>
    </div>

    <div class="card-body p-4">
        <div class="row g-4">

            <div class="col-md-4">
                <label class="form-label fw-semibold">Provider</label>
                <input class="form-control premium-input" @bind="giftModel.Provider" @ref="providerInput" placeholder="e.g., Amazon" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Prize Pool Amount</label>
                <input class="form-control premium-input" @bind="giftModel.WinnerPrizeAmount" placeholder="e.g., $500" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Prize Pool Text</label>
                <input class="form-control premium-input" @bind="giftModel.PrizePoolText" placeholder="e.g., $500 Amazon Gift Card" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Winners Count</label>
                <input class="form-control premium-input" type="number" @bind="giftModel.WinnerCount" placeholder="e.g., 10" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Winner Text</label>
                <input class="form-control premium-input" @bind="giftModel.WinnerText" placeholder="e.g., 10 Lucky Winners" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Coins Required</label>
                <input type="number" class="form-control premium-input" @bind="giftModel.CoinsRequired" placeholder="e.g., 100" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Total Slots</label>
                <input type="number" class="form-control premium-input" @bind="giftModel.TotalSlots" placeholder="e.g., 1000" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Remaining Slots</label>
                <input type="number" class="form-control premium-input" @bind="giftModel.RemainingSlots" placeholder="e.g., 500" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">From Date</label>
                <input type="date"
                       class="form-control premium-input"
                       @bind-value="giftModel.FromDate"
                       @bind-value:event="onchange" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">To Date</label>
                <input type="date"
                       class="form-control premium-input"
                       @bind-value="giftModel.ToDate"
                       @bind-value:event="onchange" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Image URL</label>
                <input class="form-control premium-input" @bind="giftModel.Image" placeholder="https://..." />
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div class="w-100">
                    <label class="form-label fw-semibold mb-3">Valid</label>
                    <label class="premium-switch">
                        <input type="checkbox" @bind="giftModel.IsActive">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div class="w-100">
                    <label class="form-label fw-semibold mb-3">Winners Locked</label>
                    <label class="premium-switch">
                        <input type="checkbox" @bind="giftModel.WinnersLocked">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div class="w-100">
                    <label class="form-label fw-semibold mb-3">Is From Entry</label>
                    <label class="premium-switch">
                        <input type="checkbox" @bind="giftModel.isFromEntry">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div class="w-100">
                    <label class="form-label fw-semibold mb-3">Allow Duplicate</label>
                    <label class="premium-switch">
                        <input type="checkbox" @bind="giftModel.AllowDuplicate">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Group Id (Date)</label>
                <input class="form-control premium-input" 
                       type="date"
                       @bind-value="groupIdDate"
                       @bind-value:event="onchange" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Code</label>
                <input class="form-control premium-input" @bind="giftModel.Code" placeholder="e.g., GIFT2024" />
            </div>

            <div class="col-12">
                @if (!IsDateValid())
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Validation Error:</strong> To Date must be same or after From Date
                    </div>
                }

                <div class="button-group d-flex gap-3 mt-4">
                    @if (isEditMode)
                    {
                        <button class="btn btn-lg btn-premium-warning"
                                disabled="@(!IsDateValid())"
                                @onclick="UpdateGift">
                            <span class="btn-icon">💾</span> Update Gift
                        </button>

                        <button class="btn btn-lg btn-premium-secondary"
                                @onclick="CancelEdit">
                            <span class="btn-icon">❌</span> Cancel
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-lg btn-premium-primary"
                                disabled="@(!IsDateValid())"
                                @onclick="CreateGift">
                            <span class="btn-icon">➕</span> Create Gift
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

                    @if (showWinnersModal)
                    {
                        <div class="premium-modal-backdrop">
                            <div class="modal fade show d-block" tabindex="-1">
                                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable winners-modal">
                                    <div class="modal-content premium-modal">
                                        <div class="modal-header premium-modal-header">
                                            <h5 class="modal-title fw-bold">🏆 Winners (Gift ID: @selectedGiftId)</h5>
                                            <button class="btn-close btn-close-white" @onclick="CloseWinners"></button>
                                        </div>

                                        <div class="modal-body">
                                            @if (!winners.Any())
                                            {
                                                <div class="text-center py-5">
                                                    <div class="empty-state-icon mb-3" style="font-size: 3rem;">😕</div>
                                                    <p class="text-muted fs-6">No winners found for this gift</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table premium-table">
                                                        <thead>
                                                            <tr>
                                                                <th>User</th>
                                                                <th>Email</th>
                                                                <th>Won At</th>
                                                                <th>NickName</th>
                                                                <th>Address</th>
                                                                <th>Phone</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var w in winners)
                                                            {
                                                                <tr class="premium-row">
                                                                    <td><strong>@w.U_Name</strong><br/><small class="text-muted">(@w.UserId)</small></td>
                                                                    <td>@w.Email</td>
                                                                    <td><span class="badge bg-light text-dark">@w.WonAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span></td>
                                                                    <td>
                                                                        <button class="btn btn-link btn-link-primary p-0"
                                                                                @onclick="() => OpenUser(w.UserId)">
                                                                            @w.UserName
                                                                        </button>
                                                                    </td>
                                                                    <td class="text-wrap">@w.U_Address</td>
                                                                    <td>@w.U_Phone</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>

                                        <div class="modal-footer bg-light">
                                            <button class="btn btn-premium-secondary" @onclick="CloseWinners">
                                                Close
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (showForceDeleteModal)
                    {
                        <div class="premium-modal-backdrop">
                            <div class="modal fade show d-block" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content premium-modal premium-modal-danger">
                                        <div class="modal-header premium-modal-header-danger">
                                            <h5 class="modal-title fw-bold">⚠️ Confirm Force Delete</h5>
                                            <button class="btn-close btn-close-white" @onclick="CancelForceDelete"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <div class="alert alert-danger d-flex align-items-center mb-3">
                                                <i class="bi bi-exclamation-triangle fs-5 me-3"></i>
                                                <span class="fw-bold">This action cannot be undone!</span>
                                            </div>
                                            <p class="fs-5 fw-semibold mb-3">Are you absolutely sure?</p>
                                            <p class="text-muted">
                                                Force deleting Gift ID <strong class="text-danger">@giftIdToForceDelete</strong> will:
                                            </p>
                                            <ul class="text-muted">
                                                <li>Permanently remove all participants</li>
                                                <li>Delete all winner records</li>
                                                <li>Cannot be recovered</li>
                                            </ul>
                                        </div>
                                        <div class="modal-footer bg-light border-0 gap-2">
                                            <button class="btn btn-premium-secondary px-4" @onclick="CancelForceDelete">
                                                No, Keep it
                                            </button>
                                            <button class="btn btn-premium-danger px-4" @onclick="ConfirmForceDelete">
                                                Yes, Force Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
@code {
    private bool isLocking = false;

    private int selectedGiftId;
    private List<GiftWinnerDto> winners = new();
    private bool showWinnersModal = false;
    private List<GiftMaster> allGifts = new();
    private List<GiftMaster> filteredGifts = new();

    private GiftMaster giftModel = CreateDefaultGift();
    private DateTime groupIdDate = DateTime.UtcNow.Date;

    private bool isEditMode = false;
    private string searchText = "";
    private string sortColumn = "";
    private bool sortAscending = true;
    private ElementReference providerInput;
    private bool focusProviderAfterEdit;
    private bool showForceDeleteModal = false;
    private int giftIdToForceDelete;
    protected override async Task OnInitializedAsync()
    {
        await LoadGifts();
    }
    private void CloseWinners()
    {
        showWinnersModal = false;
        winners.Clear();
    }
    private async Task LockWinners(int giftId, bool isFromEntry, string? code = null)
    {
        isLocking = true;

        try
        {
            if (await GiftApi.LockGiftWinnersAsync(giftId, isFromEntry, code))
            {
                await LoadGifts();
                Nav.NavigateTo($"/admin/ranks/{giftId}");
            }
        }
        finally
        {
            isLocking = false;
        }
    }
    private async Task ViewWinners(int giftId)
    {
        selectedGiftId = giftId;
        winners = await GiftApi.GetWinnersWithUserAsync(giftId);
        showWinnersModal = true;
    }

    private static GiftMaster CreateDefaultGift()
    {
        return new GiftMaster
        {
            FromDate = DateTime.UtcNow.Date,
            ToDate = DateTime.UtcNow.Date.AddDays(3),
            IsActive = true
        };
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusProviderAfterEdit)
        {
            focusProviderAfterEdit = false;
            await providerInput.FocusAsync();
        }
    }

    private async Task LoadGifts()
    {
        allGifts = (await GiftApi.GetAllAsync())?.ToList() ?? new();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredGifts = allGifts
            .Where(g =>
                string.IsNullOrWhiteSpace(searchText)
                || g.Provider.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || g.PrizePoolText.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

        ApplySorting();
    }

    private void SortBy(string column)
    {
        sortAscending = sortColumn == column ? !sortAscending : true;
        sortColumn = column;
        ApplySorting();
    }

    private void ApplySorting()
    {
        if (!string.IsNullOrEmpty(sortColumn))
        {
            filteredGifts = sortAscending
                ? filteredGifts.OrderBy(g => g.GetType().GetProperty(sortColumn)?.GetValue(g)).ToList()
                : filteredGifts.OrderByDescending(g => g.GetType().GetProperty(sortColumn)?.GetValue(g)).ToList();
        }
    }

    private async Task CreateGift()
    {
        // Convert DateTime to DDMMYYYY format and store as string
        giftModel.GroupId = groupIdDate.ToString("ddMMyyyy");

        await GiftApi.CreateAsync(giftModel);
        giftModel = CreateDefaultGift();
        groupIdDate = DateTime.UtcNow.Date;
        await LoadGifts();
    }

    private void EditGift(GiftMaster gift)
    {
        giftModel = new GiftMaster
        {
            Id = gift.Id,
            Provider = gift.Provider,
            PrizePoolText = gift.PrizePoolText,
            WinnerText = gift.WinnerText,
            CoinsRequired = gift.CoinsRequired,
            TotalSlots = gift.TotalSlots,
            RemainingSlots = gift.RemainingSlots,
            Image = gift.Image,
            FromDate = gift.FromDate.Date,
            ToDate = gift.ToDate.Date,
            IsActive = gift.IsActive,
            WinnerCount = gift.WinnerCount,
            WinnerPrizeAmount = gift.WinnerPrizeAmount,
            WinnersLocked = gift.WinnersLocked,
            isFromEntry = gift.isFromEntry,
            Code = gift.Code,
            AllowDuplicate = gift.AllowDuplicate,
            GroupId = gift.GroupId
        };

        // Convert GroupId string (DDMMYYYY) to DateTime for date picker
        if (!string.IsNullOrEmpty(gift.GroupId) && gift.GroupId.Length == 8)
        {
            if (int.TryParse(gift.GroupId.Substring(0, 2), out int day) &&
                int.TryParse(gift.GroupId.Substring(2, 2), out int month) &&
                int.TryParse(gift.GroupId.Substring(4, 4), out int year))
            {
                try
                {
                    groupIdDate = new DateTime(year, month, day);
                }
                catch
                {
                    groupIdDate = DateTime.UtcNow.Date;
                }
            }
        }
        else
        {
            groupIdDate = DateTime.UtcNow.Date;
        }

        isEditMode = true;
        focusProviderAfterEdit = true;
    }

    private async Task UpdateGift()
    {
        // Convert DateTime to DDMMYYYY format and store as string
        giftModel.GroupId = groupIdDate.ToString("ddMMyyyy");

        await GiftApi.UpdateAsync(giftModel.Id, giftModel);
        isEditMode = false;
        giftModel = CreateDefaultGift();
        groupIdDate = DateTime.UtcNow.Date;
        await LoadGifts();
    }

    private void CancelEdit()
    {
        isEditMode = false;
        giftModel = CreateDefaultGift();
        groupIdDate = DateTime.UtcNow.Date;
    }

    private async Task DeleteGift(int id)
    {
        await GiftApi.DeleteAsync(id);
        await LoadGifts();
    }
    private async Task ForceDeleteGift(int id)
    {
        await GiftApi.ForceDeleteAsync(id);
        await LoadGifts();
    }

    private bool IsDateValid()
    {
        return giftModel.ToDate.Date >= giftModel.FromDate.Date;
    }

    private string GetEndsText(DateTime toDate)
    {
        var days = (toDate.Date - DateTime.UtcNow.Date).Days;

        if (days < 0) return "Ended";
        if (days == 0) return "Ends today";
        if (days == 1) return "Ends in 1 day";
        return $"Ends in {days} days";
    }

    private string GetEndsBadge(DateTime toDate)
    {
        var days = (toDate.Date - DateTime.UtcNow.Date).Days;

        if (days < 0) return "bg-danger";
        if (days == 0) return "bg-warning";
        return "bg-info";
    }
    private void ViewParticipants(int giftId)
    {
        Nav.NavigateTo($"/admin/gifts/{giftId}/participants");
    }
    private void OpenUser(string userId)
    {
        Nav.NavigateTo($"/admin/users?selectedUserId={userId}");
    }
    private void PrepareForceDelete(int id)
    {
        giftIdToForceDelete = id;
        showForceDeleteModal = true;
    }

    private void CancelForceDelete()
    {
        showForceDeleteModal = false;
    }

    private async Task ConfirmForceDelete()
    {
        showForceDeleteModal = false; // Close modal immediately
        await GiftApi.ForceDeleteAsync(giftIdToForceDelete);
        await LoadGifts();
    }
    private async Task UnlockWinners(int giftId)
    {
        isLocking = true;

        try
        {
            await GiftApi.UnlockGiftWinnersAsync(giftId);
            await LoadGifts(); // refresh list
        }
        finally
        {
            isLocking = false;
        }
    }
}

<style>
    /* Page Header */
    .page-header {
        padding: 2rem 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        color: white;
        box-shadow: 0 8px 24px rgba(102, 126, 234, 0.2);
    }

    .page-header h1 {
        color: white;
        letter-spacing: -0.5px;
    }

    .page-header p {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    /* Search Container */
    .search-container {
        position: relative;
    }

    .premium-input {
        border: 2px solid #e8ecf1;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: #f8fafc;
    }

    .premium-input:focus {
        border-color: #667eea;
        background-color: white;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
    }

    .premium-input::placeholder {
        color: #9ca3af;
    }

    /* Premium Card */
    .premium-card {
        border-radius: 16px;
        border: none;
        background: white;
        transition: all 0.3s ease;
