    // SHOP
    private void NewShop()
    {
        shopModel = new ShopItems
        {
            ShopItemId = 0,
            Id = "",
            Name = "",
            Icon = "",
            Price = 0,
            Reward = 0,
            IsDeleted = false
        };
    }

    private void EditShop(ShopItems s)
    {
        if (s == null) return;

        shopModel = new ShopItems
        {
            ShopItemId = s.ShopItemId,
            Id = s.Id ?? "",
            Name = s.Name ?? "",
            Icon = s.Icon ?? "",
            Price = s.Price,
            Reward = s.Reward,
            IsDeleted = s.IsDeleted
        };
    }

    private void CancelShop() => shopModel = null;

    private async Task SaveShop()
    {
        if (shopModel == null)
            return;

        if (string.IsNullOrWhiteSpace(shopModel.Id))
        {
            error = "Product ID is required";
            return;
        }

        if (string.IsNullOrWhiteSpace(shopModel.Name))
        {
            error = "Item name is required";
            return;
        }

        if (shopModel.Price < 0 || shopModel.Reward < 0)
        {
            error = "Price and reward cannot be negative";
            return;
        }

        isShopLoading = true;
        error = null;

        try
        {
            shopModel.Id ??= "";
            shopModel.Name ??= "";
            shopModel.Icon ??= "";

            if (shopModel.ShopItemId == 0)
            {
                var items = await Api.GetShopItems();
                var list = (items ?? Enumerable.Empty<ShopItems>())
                           .Where(x => x != null)
                           .ToList();

                shopModel.ShopItemId = list.Any()
                    ? list.Max(x => x.ShopItemId) + 1
                    : 1;

                await Api.InsertShopItem(shopModel);
                ShowSuccessMessage("✅ Shop item created successfully!");
            }
            else
            {
                await Api.UpdateShopItem(shopModel);
                ShowSuccessMessage("✅ Shop item updated successfully!");
            }

            var updated = await Api.GetShopItems();
            config.ShopConfiguration = (updated ?? Enumerable.Empty<ShopItems>())
                                       .Where(x => x != null && !x.IsDeleted)
                                       .ToList();

            shopModel = null;
        }
        catch (Exception ex)
        {
            error = $"Failed to save shop item: {ex.Message}";
        }
        finally
        {
            isShopLoading = false;
        }
    }

    private void ConfirmDeleteShop(ShopItems s)
    {
        if (s == null) return;
        deleteConfirmationMessage = $"Are you sure you want to delete '{s.Name}'? This action cannot be undone.";
        showDeleteConfirmation = true;
        pendingDeleteAction = async () => await DeleteShop(s);
    }

    private async Task DeleteShop(ShopItems s)
    {
        if (s == null) return;

        try
        {
            s.IsDeleted = true;
            await Api.DeleteShopItem(s.Id);

            var items = await Api.GetShopItems();
            config.ShopConfiguration = (items ?? Enumerable.Empty<ShopItems>())
                                       .Where(x => x != null && !x.IsDeleted)
                                       .ToList();
            ShowSuccessMessage($"✅ Shop item '{s.Name}' deleted successfully!");
        }
        catch (Exception ex)
        {
            error = $"Failed to delete shop item: {ex.Message}";
        }
    }

    // Delete confirmation handlers
    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        pendingDeleteAction = null;
    }

    private async Task ConfirmedDelete()
    {
        showDeleteConfirmation = false;
        if (pendingDeleteAction != null)
        {
            await pendingDeleteAction();
        }
        pendingDeleteAction = null;
    }
