    // CHARACTERS
    private void NewCharacter()
    {
        characterModel = new CharacterConfiguration
        {
            Name = "",
            PrefabName = "",
            IconUrl = "",
            BundleUrl = "",
            Hash = "",
            SizeText = "",
            UnlockCoins = 0,
            Version = 1,
            DefaultUnlocked = false,
        };
    }

    private void EditCharacter(CharacterConfiguration c)
    {
        if (c == null) return;

        characterModel = new CharacterConfiguration
        {
            Id = c.Id,
            Name = c.Name ?? "",
            PrefabName = c.PrefabName ?? "",
            IconUrl = c.IconUrl ?? "",
            BundleUrl = c.BundleUrl ?? "",
            Hash = c.Hash ?? "",
            SizeText = c.SizeText ?? "",
            UnlockCoins = c.UnlockCoins,
            DefaultUnlocked = c.DefaultUnlocked,
            Version = c.Version
        };
    }

    private void CancelCharacter() => characterModel = null;

    private async Task SaveCharacter()
    {
        if (characterModel == null)
            return;

        if (string.IsNullOrWhiteSpace(characterModel.Name))
        {
            error = "Character name is required";
            return;
        }

        if (characterModel.UnlockCoins < 0 || characterModel.Version < 1)
        {
            error = "Unlock coins cannot be negative and version must be at least 1";
            return;
        }

        isCharacterLoading = true;
        error = null;

        try
        {
            characterModel.Name ??= "";
            characterModel.PrefabName ??= "";
            characterModel.IconUrl ??= "";
            characterModel.BundleUrl ??= "";
            characterModel.Hash ??= "";
            characterModel.SizeText ??= "";

            if (characterModel.Id == 0)
            {
                var characters = await Api.GetCharacters();
                var list = characters?.ToList() ?? new List<CharacterConfiguration>();
                int nextId = list.Any() ? list.Max(x => x.Id) + 1 : 1;
                characterModel.Id = nextId;

                await Api.InsertCharacter(characterModel);
                ShowSuccessMessage("✅ Character created successfully!");
            }
            else
            {
                await Api.UpdateCharacter(characterModel);
                ShowSuccessMessage("✅ Character updated successfully!");
            }

            config.CharacterConfiguration = (await Api.GetCharacters()).ToList();
            characterModel = null;
        }
        catch (Exception ex)
        {
            error = $"Failed to save character: {ex.Message}";
        }
        finally
        {
            isCharacterLoading = false;
        }
    }

    private void ConfirmDeleteCharacter(CharacterConfiguration c)
    {
        if (c == null) return;
        deleteConfirmationMessage = $"Are you sure you want to delete '{c.Name}'? This action cannot be undone.";
        showDeleteConfirmation = true;
        pendingDeleteAction = async () => await DeleteCharacter(c);
    }

    private async Task DeleteCharacter(CharacterConfiguration c)
