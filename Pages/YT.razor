@page "/admin/youtube-videos"
@using SharedLib.Models
@using WASM.api
@inject Iytapi VideoApi

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold mb-2">▶️ YouTube Video Manager</h1>
    <p class="text-muted">Manage YouTube videos and manual video uploads</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="search-container">
            <input class="form-control form-control-lg premium-input"
                   placeholder="🔍 Search videos by title..."
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>
    </div>

    <div class="col-md-4 d-flex gap-2">
        <button class="btn btn-premium-secondary flex-grow-1"
                @onclick="SyncYoutube">
            <span class="btn-icon">🔄</span> Sync YouTube
        </button>
    </div>
</div>

<div class="card premium-card shadow-lg border-0 mb-4">
    <div class="card-header premium-header">
        <h5 class="mb-0">📺 Video List</h5>
    </div>

    <div class="table-responsive premium-table-container">
        <table class="table premium-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="cursor: pointer;" @onclick="() => SortBy(nameof(YouTubeVideo.Title))">
                        Title <span class="sort-icon">⇅</span>
                    </th>
                    <th>Thumbnail</th>
                    <th>Video</th>
                    <th>Source</th>
                    <th>Published</th>
                    <th class="text-end" style="width: 150px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!filteredVideos.Any())
                {
                    <tr class="empty-state">
                        <td colspan="6" class="text-center py-5">
                            <div style="font-size: 3rem; margin-bottom: 1rem;">📺</div>
                            <h5 class="text-muted fw-semibold">No Videos Found</h5>
                            <p class="text-muted">Upload or sync videos to get started</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var v in filteredVideos)
                    {
                        <tr class="premium-row">
                            <td>
                                <span class="fw-semibold">@v.Title</span>
                            </td>

                            <td>
                                <img src="@v.ThumbnailUrl"
                                     class="rounded"
                                     style="width:80px;height:50px;object-fit:cover;border:2px solid #667eea;" />
                            </td>

                            <td>
                                <a href="@v.VideoUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    Open ↗
                                </a>
                            </td>

                            <td>
                                <span class="badge @(v.Source == "YouTube" ? "bg-danger" : "bg-success") text-white">
                                    @v.Source
                                </span>
                            </td>

                            <td>
                                <span class="text-muted">@v.PublishedAt.ToString("dd MMM yyyy")</span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (v.Source == "Manual")
                                    {
                                        <button class="btn btn-sm btn-icon-primary"
                                                title="Edit Video"
                                                @onclick="() => EditVideo(v)">
                                            ✏️
                                        </button>

                                        <button class="btn btn-sm btn-icon-danger"
                                                title="Delete Video"
                                                @onclick="() => DeleteVideo(v.Id)">
                                            🗑
                                        </button>
                                    }

                                    <button class="btn btn-sm btn-icon-danger"
                                            title="Force Delete"
                                            @onclick="() => PrepareForceDelete(v.Id)"
                                            style="opacity: 0.6;">
                                        💀
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ADD / EDIT FORM -->
<div class="card premium-card shadow-lg border-0">
    <div class="card-header premium-header">
        <h5 class="mb-0">@(isEdit ? "✏️ Edit Video" : "➕ Add Manual Video")</h5>
    </div>

    <div class="card-body p-4">
        <div class="row g-4">

            <div class="col-md-6">
                <label class="form-label fw-semibold">Video Title</label>
                <input class="form-control premium-input" 
                       @bind="videoModel.Title"
                       placeholder="Enter video title..." />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Thumbnail URL</label>
                <input class="form-control premium-input" 
                       @bind="videoModel.ThumbnailUrl"
                       placeholder="https://example.com/thumbnail.jpg" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Video URL</label>
                <input class="form-control premium-input" 
                       @bind="videoModel.VideoUrl"
                       placeholder="https://youtube.com/watch?v=..." />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Published Date</label>
                <input type="date"
                       class="form-control premium-input"
                       @bind-value="videoModel.PublishedAt"
                       @bind-value:event="onchange" />
            </div>

            <div class="col-12">
                <div class="button-group d-flex gap-3 mt-2">
                    @if (isEdit)
                    {
                        <button class="btn btn-lg btn-premium-warning" @onclick="UpdateVideo">
                            <span class="btn-icon">💾</span> Update Video
                        </button>

                        <button class="btn btn-lg btn-premium-secondary" @onclick="CancelEdit">
                            <span class="btn-icon">❌</span> Cancel
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-lg btn-premium-primary" @onclick="AddVideo">
                            <span class="btn-icon">➕</span> Add Video
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FORCE DELETE MODAL -->
@if (showForceDelete)
{
    <div class="premium-modal-backdrop">
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content premium-modal">

                    <div class="modal-header premium-modal-header-danger">
                        <h5 class="modal-title fw-bold">⚠️ Force Delete</h5>
                        <button class="btn-close btn-close-white" @onclick="CancelForceDelete"></button>
                    </div>

                    <div class="modal-body">
                        <p class="fs-5 fw-semibold mb-3">Are you sure?</p>
                        <p class="text-muted">
                            This will permanently delete the video. This action cannot be undone.
                        </p>
                    </div>

                    <div class="modal-footer bg-light">
                        <button class="btn btn-premium-secondary" @onclick="CancelForceDelete">
                            No, Keep it
                        </button>
                        <button class="btn btn-danger" @onclick="ConfirmForceDelete">
                            Yes, Delete
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@code {

    private List<YouTubeVideo> allVideos = new();
    private List<YouTubeVideo> filteredVideos = new();

    private YouTubeVideo videoModel = CreateYouTubeVideo();
    private bool isEdit = false;

    private string searchText = "";
    private string sortColumn = "";
    private bool sortAsc = true;

    private bool showForceDelete = false;
    private Guid forceDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadVideos();
    }

    private async Task LoadVideos()
    {
        allVideos = await VideoApi.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredVideos = allVideos
            .Where(v =>
                string.IsNullOrWhiteSpace(searchText)
                || v.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

        ApplySort();
    }

    private void SortBy(string col)
    {
        sortAsc = sortColumn == col ? !sortAsc : true;
        sortColumn = col;
        ApplySort();
    }

    private void ApplySort()
    {
        if (!string.IsNullOrEmpty(sortColumn))
        {
            filteredVideos = sortAsc
                ? filteredVideos.OrderBy(v => v.GetType().GetProperty(sortColumn)?.GetValue(v)).ToList()
                : filteredVideos.OrderByDescending(v => v.GetType().GetProperty(sortColumn)?.GetValue(v)).ToList();
        }
    }

    private async Task SyncYoutube()
    {
        await VideoApi.SyncAsync();
        await LoadVideos();
    }

    private async Task AddVideo()
    {
        await VideoApi.AddManualAsync(videoModel);
        videoModel = new();
        await LoadVideos();
    }

    private void EditVideo(YouTubeVideo v)
    {
        isEdit = true;
        videoModel = new YouTubeVideo
        {
            Id = v.Id,
            Title = v.Title,
            ThumbnailUrl = v.ThumbnailUrl,
            VideoUrl = v.VideoUrl,
            PublishedAt = v.PublishedAt
        };
    }

    private async Task UpdateVideo()
    {
        await VideoApi.UpdateManualAsync(videoModel.Id, videoModel);
        CancelEdit();
        await LoadVideos();
    }

    private void CancelEdit()
    {
        isEdit = false;
        videoModel = new();
    }

    private async Task DeleteVideo(Guid id)
    {
        await VideoApi.DeleteManualAsync(id);
        await LoadVideos();
    }

    private void PrepareForceDelete(Guid id)
    {
        forceDeleteId = id;
        showForceDelete = true;
    }

    private void CancelForceDelete()
    {
        showForceDelete = false;
    }

    private async Task ConfirmForceDelete()
    {
        showForceDelete = false;
        await VideoApi.ForceDeleteAsync(forceDeleteId);
        await LoadVideos();
    }
    private static YouTubeVideo CreateYouTubeVideo()
    {
        return new YouTubeVideo
        {
            PublishedAt = DateTime.UtcNow.Date,
        };
    }
}

<style>
    /* Page Header */
    .page-header {
        padding: 2rem 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        color: white;
        box-shadow: 0 8px 24px rgba(102, 126, 234, 0.2);
    }

    .page-header h1 {
        color: white;
        letter-spacing: -0.5px;
    }

    .page-header p {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    /* Search Container */
    .search-container {
        position: relative;
    }

    .premium-input {
        border: 2px solid #e8ecf1;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: #f8fafc;
    }

    .premium-input:focus {
        border-color: #667eea;
        background-color: white;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
    }

    .premium-input::placeholder {
        color: #9ca3af;
    }

    /* Premium Card */
    .premium-card {
        border-radius: 16px;
        border: none;
        background: white;
        transition: all 0.3s ease;
    }

    .premium-card:hover {
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1) !important;
    }

    .premium-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px 16px 0 0 !important;
        padding: 1.5rem !important;
        border: none !important;
    }

    .premium-header h5 {
        color: white;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

    /* Table Styling */
    .premium-table-container {
        max-height: 600px;
        overflow-y: auto;
        border-radius: 0 0 16px 16px;
    }

    .premium-table {
        margin-bottom: 0;
    }

    .premium-table thead {
        background-color: #f8fafc;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .premium-table thead th {
        border: none;
        color: #1f2937;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e5e7eb;
        user-select: none;
    }

    .premium-table thead th:hover {
        background-color: #eef2ff;
    }

    .sort-icon {
        opacity: 0.5;
        transition: opacity 0.2s ease;
    }

    .premium-table thead th:hover .sort-icon {
        opacity: 1;
    }

    .premium-table tbody tr {
        border-bottom: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }

    .premium-table tbody tr:hover {
        background-color: #f9fafb;
    }

    .premium-table td {
        padding: 1rem;
        vertical-align: middle;
    }

    .premium-row {
        transition: all 0.2s ease;
    }

    .premium-row:hover {
        background-color: #f0f4ff;
    }

    .empty-state {
        background-color: #f9fafb;
    }

    /* Button Icons */
    .btn-icon-primary,
    .btn-icon-danger {
        width: 36px;
        height: 36px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 1.1rem;
        border: none;
    }

    .btn-icon-primary {
        background-color: #dbeafe;
        color: #0369a1;
    }

    .btn-icon-primary:hover {
        background-color: #bfdbfe;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(3, 105, 161, 0.2);
    }

    .btn-icon-danger {
        background-color: #fee2e2;
        color: #dc2626;
    }

    .btn-icon-danger:hover {
        background-color: #fecaca;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
    }

    /* Premium Buttons */
    .btn-premium-primary,
    .btn-premium-secondary,
    .btn-premium-warning {
        border: none;
        border-radius: 10px;
        font-weight: 700;
        padding: 12px 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.95rem;
    }

    .btn-icon {
        margin-right: 8px;
    }

    .btn-premium-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .btn-premium-primary:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    .btn-premium-secondary {
        background-color: #e5e7eb;
        color: #1f2937;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .btn-premium-secondary:hover:not(:disabled) {
        background-color: #d1d5db;
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .btn-premium-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
    }

    .btn-premium-warning:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
    }

    .button-group {
        margin-top: 1rem;
    }

    /* Modal Styling */
    .premium-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .premium-modal {
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .premium-modal-header-danger {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
        color: white;
        border: none;
        border-radius: 16px 16px 0 0 !important;
        padding: 1.5rem !important;
    }

    .premium-modal .modal-body {
        padding: 2rem;
        font-size: 0.95rem;
        color: #374151;
    }

    .premium-modal .modal-footer {
        border-top: 1px solid #e5e7eb;
        padding: 1.5rem;
        background-color: #f9fafb;
    }

    /* Scrollbar Styling */
    .premium-table-container::-webkit-scrollbar {
        width: 8px;
    }

    .premium-table-container::-webkit-scrollbar-track {
        background: transparent;
    }

    .premium-table-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .premium-table-container::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .premium-table-container {
            max-height: 400px;
        }

        .btn-icon-primary,
        .btn-icon-danger {
            width: 32px;
            height: 32px;
            font-size: 0.9rem;
        }

        .button-group {
            flex-direction: column;
        }

        .btn-premium-primary,
        .btn-premium-secondary,
        .btn-premium-warning {
            width: 100%;
        }

        .page-header {
            padding: 1.5rem 1rem;
        }

        .page-header h1 {
            font-size: 1.75rem;
        }

        .premium-table td {
            padding: 0.75rem 0.5rem;
            font-size: 0.85rem;
        }
    }
</style>
