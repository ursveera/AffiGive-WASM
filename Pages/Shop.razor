@page "/admin/shop"
@using WASM.Api
@using SharedLib.Models
@inject IShopApi ShopApi

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold mb-2">🛒 Shop Manager</h1>
    <p class="text-muted">Manage shop items and rewards</p>
</div>

<div class="search-container mb-4">
    <input class="form-control form-control-lg premium-input"
           placeholder="🔍 Search by item name or ID..."
           @bind="searchText"
           @bind:event="oninput" />
</div>

<div class="card premium-card shadow-lg border-0 mb-4">
    <div class="card-header premium-header">
        <h5 class="mb-0">📋 Shop Items</h5>
    </div>

    <div class="table-responsive premium-table-container">
        <table class="table premium-table align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Icon</th>
                    <th>Price</th>
                    <th>Reward</th>
                    <th class="text-end" style="width: 150px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!filteredItems.Any())
                {
                    <tr class="empty-state">
                        <td colspan="6" class="text-center py-5">
                            <div style="font-size: 3rem; margin-bottom: 1rem;">🛍️</div>
                            <h5 class="text-muted fw-semibold">No Shop Items Found</h5>
                            <p class="text-muted">Create your first shop item to get started</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in filteredItems)
                    {
                        <tr class="premium-row">
                            <td>
                                <span class="badge bg-gradient-primary">@item.Id</span>
                            </td>

                            <td>
                                <span class="fw-semibold">@item.Name</span>
                            </td>

                            <td>
                                <span style="font-size: 1.5rem;">@item.Icon</span>
                            </td>

                            <td>
                                <span class="badge bg-info text-white">
                                    @item.Price
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-success text-white">
                                    +@item.Reward
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-icon-primary"
                                            title="Edit Item"
                                            @onclick="() => EditItem(item)">
                                        ✏️
                                    </button>

                                    <button class="btn btn-sm btn-icon-danger"
                                            title="Delete Item"
                                            @onclick="() => DeleteItem(item.Id)">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card premium-card shadow-lg border-0">
    <div class="card-header premium-header">
        <h5 class="mb-0">@(isEditMode ? "✏️ Edit Item" : "➕ Create Item")</h5>
    </div>

    <div class="card-body p-4">
        <div class="row g-4">

            <div class="col-md-4">
                <label class="form-label fw-semibold">Item ID</label>
                <input class="form-control premium-input" 
                       @bind="itemModel.Id"
                       placeholder="unique-item-id" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Item Name</label>
                <input class="form-control premium-input" 
                       @bind="itemModel.Name"
                       placeholder="Item name..." />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Icon Emoji</label>
                <input class="form-control premium-input" 
                       @bind="itemModel.Icon"
                       placeholder="🎁" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Price</label>
                <input type="number"
                       class="form-control premium-input"
                       @bind="itemModel.Price"
                       placeholder="0" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Reward</label>
                <input type="number"
                       class="form-control premium-input"
                       @bind="itemModel.Reward"
                       placeholder="0" />
            </div>

            <div class="col-12">
                <div class="button-group d-flex gap-3 mt-2">
                    @if (isEditMode)
                    {
                        <button class="btn btn-lg btn-premium-warning"
                                @onclick="UpdateItem">
                            <span class="btn-icon">💾</span> Update Item
                        </button>

                        <button class="btn btn-lg btn-premium-secondary"
                                @onclick="CancelEdit">
                            <span class="btn-icon">❌</span> Cancel
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-lg btn-premium-primary"
                                @onclick="CreateItem">
                            <span class="btn-icon">➕</span> Create Item
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


@code {

    private List<ShopItems> allItems = new();
    private List<ShopItems> filteredItems = new();

    private ShopItems itemModel = CreateDefaultItem();

    private bool isEditMode = false;

    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private static ShopItems CreateDefaultItem()
    {
        return new ShopItems();
    }

    private async Task LoadItems()
    {
        var items = await ShopApi.GetAllAsync();
        allItems = items.ToList();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredItems = allItems
            .Where(i =>
                string.IsNullOrWhiteSpace(searchText)
                || i.Id.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || i.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task CreateItem()
    {
        await ShopApi.CreateAsync(itemModel);
        itemModel = CreateDefaultItem();
        await LoadItems();
    }

    private void EditItem(ShopItems item)
    {
        itemModel = new ShopItems
        {
            Id = item.Id,
            Name = item.Name,
            Icon = item.Icon,
            Price = item.Price,
            Reward = item.Reward
        };

        isEditMode = true;
    }

    private async Task UpdateItem()
    {
        await ShopApi.UpdateAsync(itemModel.Id, itemModel);

        isEditMode = false;

        itemModel = CreateDefaultItem();

        await LoadItems();
    }

    private void CancelEdit()
    {
        isEditMode = false;
        itemModel = CreateDefaultItem();
    }

    private async Task DeleteItem(string id)
    {
        await ShopApi.DeleteAsync(id);
        await LoadItems();
    }
}

<style>
    /* Page Header */
    .page-header {
        padding: 2rem 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        color: white;
        box-shadow: 0 8px 24px rgba(102, 126, 234, 0.2);
    }

    .page-header h1 {
        color: white;
        letter-spacing: -0.5px;
    }

    .page-header p {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    /* Search Container */
    .search-container {
        position: relative;
    }

    .premium-input {
        border: 2px solid #e8ecf1;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: #f8fafc;
    }

    .premium-input:focus {
        border-color: #667eea;
        background-color: white;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
    }

    .premium-input::placeholder {
        color: #9ca3af;
    }

    /* Premium Card */
    .premium-card {
        border-radius: 16px;
        border: none;
        background: white;
        transition: all 0.3s ease;
    }

    .premium-card:hover {
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1) !important;
    }

    .premium-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px 16px 0 0 !important;
        padding: 1.5rem !important;
        border: none !important;
    }

    .premium-header h5 {
        color: white;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

    /* Table Styling */
