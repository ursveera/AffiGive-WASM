@page "/admin/users"
@using AffiGive_API_V1.Models
@using WASM.api
@inject IUserApi UserApi
@inject NavigationManager Nav

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold mb-2">👥 Users Management</h1>
    <p class="text-muted">Manage and view all registered users</p>
</div>

<div class="search-container mb-4">
    <input class="form-control form-control-lg premium-input"
           placeholder="🔍 Search by name, email, phone, invite code, status..."
           @bind="searchText"
           @bind:event="oninput" />
</div>

@if (users == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-3">Loading users...</p>
    </div>
}
else if (!FilteredUsers.Any())
{
    <div class="card premium-card shadow-lg border-0">
        <div class="card-body p-5 text-center">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🚫</div>
            <h5 class="text-muted fw-semibold">No Users Found</h5>
            <p class="text-muted">Try adjusting your search filters</p>
        </div>
    </div>
}
else
{
    <div class="card premium-card shadow-lg border-0">
        <div class="card-header premium-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">👥 Users List</h5>
                <span class="badge bg-light text-dark">@FilteredUsers.Count()</span>
            </div>
        </div>

        <div class="table-responsive premium-table-container">
            <table class="table premium-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Account</th>
                        <th>Created</th>
                        <th>Last Login</th>
                        <th class="text-end" style="width: 200px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var (u, i) in FilteredUsers.Select((v, i) => (v, i + 1)))
                    {
                        <tr class="premium-row @(IsSelectedUser(u) ? "selected-row" : "")">
                            <td>
                                <span class="badge bg-gradient-primary">@i</span>
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(u.ProfileImage))
                                    {
                                        <img src="@u.ProfileImage"
                                             class="rounded-circle"
                                             style="width:32px;height:32px;object-fit:cover;"
                                             onerror="this.style.display='none'" />
                                    }
                                    <button class="btn btn-link text-start p-0 user-link"
                                            @onclick="() => ShowUserCoins(u)">
                                        <div class="fw-semibold">@(u.Name ?? "(No Name)")</div>
                                        <div class="text-muted small">@u.NickName</div>
                                    </button>
                                </div>
                            </td>

                            <td>
                                <a href="mailto:@u.Email" class="text-primary">@u.Email</a>
                            </td>

                            <td>
                                <span class="text-muted">@u.Phone</span>
                            </td>

                            <td>
                                <span class="status-badge @(u.isActive ? "active" : "inactive")">
                                    @(u.isActive ? "✓ Active" : "✗ Inactive")
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-info text-white">@u.AccountStatus</span>
                            </td>

                            <td>
                                <span class="text-muted">@u.CreatedAt.ToString("dd MMM yyyy")</span>
                            </td>

                            <td>
                                <span class="text-muted">@u.LastLogin.ToString("dd MMM yyyy")</span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-icon-info"
                                            title="View User"
                                            @onclick="() => ViewUser(u)">
                                        👁
                                    </button>

                                    <button class="btn btn-sm btn-icon-primary"
                                            title="Edit User"
                                            @onclick="() => EditUser(u)">
                                        ✏️
                                    </button>

                                    <button class="btn btn-sm btn-icon-warning"
                                            title="Deactivate User"
                                            @onclick="() => DeactivateUser(u)">
                                        🚫
                                    </button>

                                    <button class="btn btn-sm btn-icon-danger"
                                            title="Force Delete"
                                            @onclick="() => AskForceDelete(u)">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- VIEW MODAL (READ ONLY) -->
@if (viewUser != null)
{
    <div class="premium-modal-backdrop">
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content premium-modal">

                    <div class="modal-header premium-modal-header">
                        <h5 class="modal-title fw-bold">👤 User Details</h5>
                        <button class="btn-close btn-close-white" @onclick="CloseView"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-4">
                            <div class="col-md-4 text-center">
                                @if (!string.IsNullOrEmpty(viewUser.ProfileImage))
                                {
                                    <img src="@viewUser.ProfileImage"
                                         class="img-fluid rounded-circle mb-3"
                                         style="max-width:120px;border:4px solid #667eea;"
                                         onerror="this.style.display='none'" />
                                }
                                <h6 class="fw-bold">@viewUser.Name</h6>
                                <span class="badge bg-gradient-primary">@viewUser.AccountStatus</span>
                            </div>

                            <div class="col-md-8">
                                <div class="info-group">
                                    <div class="info-item mb-3">
                                        <label class="info-label">User ID</label>
                                        <p class="info-value"><code>@viewUser.Id</code></p>
                                    </div>

                                    <div class="info-item mb-3">
                                        <label class="info-label">Google ID</label>
                                        <p class="info-value">@(string.IsNullOrEmpty(viewUser.GoogleId) ? "N/A" : viewUser.GoogleId)</p>
                                    </div>

                                    <div class="info-item mb-3">
                                        <label class="info-label">Name</label>
                                        <p class="info-value">@viewUser.Name</p>
                                    </div>

                                    <div class="info-item mb-3">
                                        <label class="info-label">Nickname</label>
                                        <p class="info-value">@viewUser.NickName</p>
                                    </div>

                                    <div class="info-item mb-3">
                                        <label class="info-label">Email</label>
                                        <p class="info-value"><a href="mailto:@viewUser.Email" class="text-primary">@viewUser.Email</a></p>
                                    </div>

                                    <div class="info-item mb-3">
                                        <label class="info-label">Phone</label>
                                        <p class="info-value">@viewUser.Phone</p>
                                    </div>

                                    <div class="info-item mb-3">
                                        <label class="info-label">Address</label>
                                        <p class="info-value text-wrap">@viewUser.Address</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button class="btn btn-premium-secondary" @onclick="CloseView">
                            Close
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

<!-- EDIT MODAL -->
@if (editUser != null)
{
    <div class="premium-modal-backdrop">
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content premium-modal">

                    <div class="modal-header premium-modal-header">
                        <h5 class="modal-title fw-bold">✏️ Edit User</h5>
                        <button class="btn-close btn-close-white" @onclick="CloseEdit"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-4">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Name</label>
                                <input class="form-control premium-input" 
                                       @bind="editUser.Name"
                                       placeholder="User name..." />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nickname</label>
                                <input class="form-control premium-input" 
                                       @bind="editUser.NickName"
                                       placeholder="Nickname..." />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email</label>
                                <input class="form-control premium-input" 
                                       @bind="editUser.Email"
                                       placeholder="email@example.com" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Phone</label>
                                <input class="form-control premium-input" 
                                       @bind="editUser.Phone"
                                       placeholder="+1234567890" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Address</label>
                                <textarea class="form-control premium-input" 
                                          rows="2"
                                          @bind="editUser.Address"
                                          placeholder="Street address..."></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Account Status</label>
                                <input class="form-control premium-input" 
                                       @bind="editUser.AccountStatus"
                                       placeholder="Active, Banned, etc..." />
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <label class="premium-switch me-3">
                                    <input type="checkbox" @bind="editUser.isActive">
                                    <span class="slider round"></span>
                                </label>
                                <label class="form-label fw-semibold mb-0">Active</label>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button class="btn btn-premium-secondary" @onclick="CloseEdit">
                            Cancel
                        </button>
                        <button class="btn btn-premium-primary" @onclick="SaveEdit">
                            <span class="btn-icon">💾</span> Save Changes
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

<!-- FORCE DELETE CONFIRM -->
@if (deleteUser != null)
{
    <div class="premium-modal-backdrop">
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content premium-modal">

                    <div class="modal-header premium-modal-header-danger">
                        <h5 class="modal-title fw-bold">⚠️ Confirm Delete</h5>
                        <button class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                    </div>

                    <div class="modal-body">
                        <p class="fs-5 fw-semibold mb-3">Are you sure?</p>
                        <p class="text-muted">
                            Permanently delete user <strong class="text-danger">@deleteUser.Name</strong> (@deleteUser.Email)?
                        </p>
                        <p class="text-muted small">This action cannot be undone.</p>
                    </div>

                    <div class="modal-footer bg-light">
                        <button class="btn btn-premium-secondary" @onclick="CancelDelete">
                            No, Keep User
                        </button>
                        <button class="btn btn-danger" @onclick="ConfirmDelete">
                            Yes, Delete Permanently
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@code {

    private List<User>? users;
    private User? viewUser;
    private User? editUser;
    private User? deleteUser;
    private string searchText = "";
    private string? selectedUserId;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        selectedUserId = query["selectedUserId"];

        users = await UserApi.GetAllUsersAsync();
    }

    /* SEARCH */
    private IEnumerable<User> FilteredUsers =>
        string.IsNullOrWhiteSpace(searchText)
            ? users!
            : users!.Where(u =>
                (u.Name ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (u.Email ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (u.Phone ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (u.InviteCode ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (u.AccountStatus ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase)
            );

    /* VIEW */
    private void ViewUser(User u) => viewUser = u;
    private void CloseView() => viewUser = null;

    /* EDIT */
    private void EditUser(User u)
    {
        // CLONE FULL OBJECT (THIS IS THE KEY)
        editUser = new User
        {
            Id = u.Id,
            GoogleId = u.GoogleId,
            Name = u.Name,
            NickName = u.NickName,
            Email = u.Email,
            Phone = u.Phone,
            Address = u.Address,
            InviteCode = u.InviteCode,
            InvitedByUserId = u.InvitedByUserId,
            AccountStatus = u.AccountStatus,
            isActive = u.isActive,

            // IMPORTANT FIELDS (DO NOT DROP)
            CreatedAt = u.CreatedAt,
            LastLogin = u.LastLogin,
            RefreshToken = u.RefreshToken,
            RefreshTokenExpiry = u.RefreshTokenExpiry,
            ProfileImage = u.ProfileImage,
            DeletedAt = u.DeletedAt
        };
    }

    private async Task SaveEdit()
    {
        if (editUser == null) return;
        await UserApi.UpdateUserAsync(editUser);
        users = await UserApi.GetAllUsersAsync();
        editUser = null;
    }

    private void CloseEdit() => editUser = null;

    /* SOFT DELETE */
    private async Task DeactivateUser(User u)
    {
        u.isActive = false;
        await UserApi.UpdateUserAsync(u);
        users = await UserApi.GetAllUsersAsync();
    }

    /* FORCE DELETE */
    private void AskForceDelete(User u) => deleteUser = u;

    private async Task ConfirmDelete()
    {
        if (deleteUser == null) return;
        await UserApi.ForceDeleteUserAsync(deleteUser.Id);
        users = await UserApi.GetAllUsersAsync();
        deleteUser = null;
    }

    private void CancelDelete() => deleteUser = null;

    private void ShowUserCoins(User u)
    {
        Nav.NavigateTo($"/admin/users/{u.Id}");
    }

    private bool IsSelectedUser(User u)
    {
        if (string.IsNullOrEmpty(selectedUserId))
            return false;

        return u.Id.ToString() == selectedUserId;
    }
}

