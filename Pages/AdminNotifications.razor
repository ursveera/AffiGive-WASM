        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-value {
        margin: 0;
        color: #1f2937;
        font-weight: 500;
    }

    /* Premium Switch */
    .premium-switch {
        position: relative;
        display: inline-block;
        width: 56px;
        height: 28px;
    }

    .premium-switch input {
        display: none;
    }

    .premium-switch .slider {
        position: absolute;
        cursor: pointer;
        background-color: #cbd5e1;
        border-radius: 34px;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .premium-switch .slider:before {
        content: "";
        position: absolute;
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
