@page "/admin/account-deletions"
@using AffiGive_API_V1.Models
@using WASM.api
@inject IAccountDeleteRequestApi Api

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold mb-2">🧨 Account Deletion Requests</h1>
    <p class="text-muted">Review and manage user account deletion requests</p>
</div>

<!-- FILTER BAR -->
<div class="card premium-card shadow-lg border-0 mb-4">
    <div class="card-header premium-header">
        <h5 class="mb-0">🔍 Search & Filter</h5>
    </div>

    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-5">
                <input class="form-control form-control-lg premium-input"
                       placeholder="🔍 Search by email or Google ID..."
                       @bind-value="searchText"
                       @bind-value:event="oninput" />
            </div>

            <div class="col-md-7">
                <div class="filter-button-group d-flex flex-wrap gap-2">
                    <button class="btn filter-btn @(statusFilter == "All" ? "filter-btn-active" : "filter-btn-inactive")"
                            @onclick='() => SetStatus("All")'>
                        📋 All
                    </button>

                    <button class="btn filter-btn @(statusFilter == "Pending" ? "filter-btn-active" : "filter-btn-inactive")"
                            @onclick='() => SetStatus("Pending")'>
                        ⏳ Pending
                    </button>

                    <button class="btn filter-btn @(statusFilter == "Approved" ? "filter-btn-active" : "filter-btn-inactive")"
                            @onclick='() => SetStatus("Approved")'>
                        ✅ Approved
                    </button>

                    <button class="btn filter-btn @(statusFilter == "Rejected" ? "filter-btn-active" : "filter-btn-inactive")"
                            @onclick='() => SetStatus("Rejected")'>
                        ❌ Rejected
                    </button>
                </div>
            </div>

            <div class="col-12">
                <div class="status-summary">
                    <span class="summary-badge">Showing <strong>@filtered.Count</strong> requests</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TABLE -->
<div class="card premium-card shadow-lg border-0">
    <div class="card-header premium-header">
        <h5 class="mb-0">📋 Deletion Requests</h5>
    </div>

    <div class="table-responsive premium-table-container">
        <table class="table premium-table align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Requested</th>
                    <th>Status</th>
                    <th>⏳ Days Left</th>
                    <th>Processed</th>
                    <th>Admin Remarks</th>
                    <th class="text-end" style="width: 180px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!filtered.Any())
                {
                    <tr class="empty-state">
                        <td colspan="7" class="text-center py-5">
                            <div style="font-size: 3rem; margin-bottom: 1rem;">🎉</div>
                            <h5 class="text-muted fw-semibold">No Requests Found</h5>
                            <p class="text-muted">All deletion requests have been processed</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in filtered)
                    {
                        <tr class="premium-row @(GetDaysRemaining(r.RequestTime) <= 7 && r.Status == "Pending" ? "urgent-row" : "")">

                            <td>
                                <div class="fw-semibold">@r.UserEmail</div>
                                <div class="text-muted small code-badge">@r.GoogleId</div>
                            </td>

                            <td>
                                <span class="text-muted">@r.RequestTime.ToString("dd MMM yyyy HH:mm")</span>
                            </td>

                            <td>
                                <span class="status-badge @("status-" + r.Status.ToLower())">
                                    @r.Status
                                </span>
                            </td>

                            <td>
                                @if (r.Status == "Approved")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    var daysLeft = GetDaysRemaining(r.RequestTime);

                                    <span class="badge @(daysLeft <= 7 ? "bg-danger" : "bg-info") fs-6 px-2 py-1">
                                        @daysLeft days
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="text-muted">@(r.ProcessedTime?.ToString("dd MMM yyyy HH:mm") ?? "-")</span>
                            </td>

                            <td>
                                <textarea class="form-control form-control-sm premium-input"
                                          rows="2"
                                          placeholder="Admin remarks..."
                                          @bind="r.Remarks"></textarea>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (r.Status != "Approved")
                                    {
                                        <button class="btn btn-sm btn-icon-success"
                                                title="Approve deletion"
                                                @onclick='() => Approve(r)'>
                                            ✅
                                        </button>
                                    }

                                    @if (r.Status != "Rejected")
                                    {
                                        <button class="btn btn-sm btn-icon-danger"
                                                title="Reject deletion"
                                                @onclick='() => Reject(r)'>
                                            ❌
                                        </button>
                                    }

                                    @if (r.Status != "Pending")
                                    {
                                        <button class="btn btn-sm btn-icon-primary"
                                                title="Revert to pending"
                                                @onclick='() => Revert(r)'>
                                            🔄
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {

    private List<AccountDeletionRequest> all = new();
    private List<AccountDeletionRequest> filtered = new();

    private string statusFilter = "Pending";

    private string _searchText = "";
    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            ApplyFilter();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        all = (await Api.GetAllAsync())?.ToList() ?? new();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filtered = all
            .Where(x =>
                (statusFilter == "All" || x.Status == statusFilter) &&
                (string.IsNullOrWhiteSpace(searchText)
                 || (x.UserEmail?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                 || (x.GoogleId.ToString()?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)))
            .OrderByDescending(x => x.RequestTime)
            .ToList();
    }

    private void SetStatus(string status)
    {
        statusFilter = status;
        ApplyFilter();
    }

    private async Task Approve(AccountDeletionRequest r)
    {
        await Api.UpdateStatusAsync(r.Id, "Approved", r.Remarks);
        await Load();
    }

    private async Task Reject(AccountDeletionRequest r)
    {
        if (string.IsNullOrWhiteSpace(r.Remarks))
            r.Remarks = "Rejected by admin";

        await Api.UpdateStatusAsync(r.Id, "Rejected", r.Remarks);
        await Load();
    }

    private async Task Revert(AccountDeletionRequest r)
    {
        r.Remarks = "Reverted to pending by admin";
        await Api.UpdateStatusAsync(r.Id, "Pending", r.Remarks);
        await Load();
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Pending" => "bg-warning",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
    private const int TOTAL_DAYS = 90;

    private int GetDaysRemaining(DateTime requestTime)
    {
        var daysPassed = (DateTime.UtcNow.Date - requestTime.Date).Days;
        var remaining = TOTAL_DAYS - daysPassed;
        return remaining < 0 ? 0 : remaining;
    }
}

<style>
    /* Page Header */
    .page-header {
        padding: 2rem 0;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        color: white;
        box-shadow: 0 8px 24px rgba(102, 126, 234, 0.2);
    }

    .page-header h1 {
        color: white;
        letter-spacing: -0.5px;
    }

    .page-header p {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    /* Premium Input */
    .premium-input {
        border: 2px solid #e8ecf1;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: #f8fafc;
    }

    .premium-input:focus {
        border-color: #667eea;
        background-color: white;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
    }

    .premium-input::placeholder {
        color: #9ca3af;
    }

    /* Premium Card */
    .premium-card {
        border-radius: 16px;
        border: none;
        background: white;
        transition: all 0.3s ease;
    }

    .premium-card:hover {
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1) !important;
    }

    .premium-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px 16px 0 0 !important;
        padding: 1.5rem !important;
        border: none !important;
    }

    .premium-header h5 {
        color: white;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

    /* Filter Button Group */
    .filter-button-group {
        gap: 0.5rem;
    }

    .filter-btn {
        border-radius: 8px;
        font-weight: 600;
        padding: 0.6rem 1.2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
    }

    .filter-btn-active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-color: #667eea;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .filter-btn-active:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
    }

    .filter-btn-inactive {
        background-color: white;
        color: #1f2937;
        border-color: #e5e7eb;
    }

    .filter-btn-inactive:hover {
        background-color: #f9fafb;
        border-color: #667eea;
        transform: translateY(-2px);
    }

    /* Status Summary */
    .status-summary {
        padding: 0.75rem 1rem;
        background-color: #f0f4ff;
        border-radius: 8px;
        border-left: 4px solid #667eea;
    }

    .summary-badge {
        color: #1f2937;
        font-weight: 600;
    }

    /* Table Styling */
    .premium-table-container {
        max-height: 700px;
        overflow-y: auto;
        border-radius: 0 0 16px 16px;
    }

    .premium-table {
        margin-bottom: 0;
    }

    .premium-table thead {
        background-color: #f8fafc;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .premium-table thead th {
        border: none;
        color: #1f2937;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e5e7eb;
    }

    .premium-table tbody tr {
        border-bottom: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }

    .premium-table tbody tr:hover {
        background-color: #f9fafb;
    }

    .premium-table td {
        padding: 1rem;
        vertical-align: middle;
    }

    .premium-row {
        transition: all 0.2s ease;
    }

    .premium-row:hover {
        background-color: #f0f4ff;
    }

    .premium-row.urgent-row {
        background-color: #fee2e2;
        border-left: 4px solid #dc2626;
    }

    .premium-row.urgent-row:hover {
        background-color: #fecaca;
    }

    .empty-state {
        background-color: #f9fafb;
    }

    /* Code Badge */
    .code-badge {
        background-color: #f3f4f6;
        color: #1f2937;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-family: 'Monaco', 'Courier New', monospace;
        font-size: 0.8rem;
    }

    /* Status Badge */
    .status-badge {
        display: inline-block;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #92400e;
    }

    .status-approved {
        background-color: #d1fae5;
        color: #065f46;
    }

    .status-rejected {
        background-color: #fee2e2;
        color: #991b1b;
    }

    /* Button Icons */
    .btn-icon-primary,
    .btn-icon-danger,
    .btn-icon-success {
        width: 36px;
        height: 36px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 1.1rem;
        border: none;
    }

    .btn-icon-primary {
        background-color: #dbeafe;
        color: #0369a1;
    }

    .btn-icon-primary:hover {
        background-color: #bfdbfe;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(3, 105, 161, 0.2);
    }

    .btn-icon-danger {
        background-color: #fee2e2;
        color: #dc2626;
    }

    .btn-icon-danger:hover {
        background-color: #fecaca;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
    }

    .btn-icon-success {
        background-color: #d1fae5;
        color: #059669;
    }

    .btn-icon-success:hover {
        background-color: #a7f3d0;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.2);
    }

    /* Scrollbar Styling */
    .premium-table-container::-webkit-scrollbar {
        width: 8px;
    }

    .premium-table-container::-webkit-scrollbar-track {
        background: transparent;
    }

    .premium-table-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .premium-table-container::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .premium-table-container {
            max-height: 400px;
        }

        .filter-button-group {
            flex-direction: column;
        }

        .filter-btn {
            width: 100%;
        }

        .btn-icon-primary,
        .btn-icon-danger,
        .btn-icon-success {
            width: 32px;
            height: 32px;
            font-size: 0.9rem;
        }

        .page-header {
            padding: 1.5rem 1rem;
        }

        .page-header h1 {
            font-size: 1.75rem;
        }

        .premium-table td {
            padding: 0.75rem 0.5rem;
            font-size: 0.85rem;
        }
    }
</style>
