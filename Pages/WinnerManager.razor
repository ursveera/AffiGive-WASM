@page "/admin/winners"
@using AffiGive_API_V1.Models
@using AffiGive_API_V1.DTO
@using AffigiveUIBalzor.api
@using SharedLib.DTO
@inject IWinnerApiGateway WinnerApi
@inject IEntryApiGateway EntryApi

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold mb-2">🏆 Winner Manager</h1>
    <p class="text-muted">Manage and pick winners from valid entries</p>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-premium alert-info mb-4">
        <div class="d-flex align-items-center">
            <span class="alert-icon me-3">ℹ️</span>
            <span>@message</span>
        </div>
    </div>
}

<!-- CRUD FORM -->
<div class="card premium-card shadow-lg border-0 mb-4">
    <div class="card-header premium-header">
        <h5 class="mb-0">@((editMode) ? "✏️ Edit Winner" : "➕ Add Winner")</h5>
    </div>

    <div class="card-body p-4">
        <div class="row g-4">

            <div class="col-md-4">
                <label class="form-label fw-semibold">Entry</label>
                <select class="form-control premium-input">
                    <option value="">-- Select Entry --</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Code</label>
                <input class="form-control premium-input" @bind="winnerModel.Code" placeholder="e.g., VID001" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Draw Date</label>
                <input type="date"
                       class="form-control premium-input"
                       value="@(winnerModel.DrawDate == DateTime.MinValue
                                           ? ""
                                           : winnerModel.DrawDate.ToString("yyyy-MM-dd"))"
                       @onchange="e => winnerModel.DrawDate =
                       string.IsNullOrWhiteSpace(e.Value?.ToString())
                           ? DateTime.MinValue
                           : DateTime.Parse(e.Value!.ToString())" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Status</label>
                <input class="form-control premium-input" @bind="winnerModel.Status" placeholder="e.g., Pending" />
            </div>

            <div class="col-12">
                <div class="button-group d-flex gap-3 mt-4">
                    @if (editMode)
                    {
                        <button class="btn btn-lg btn-premium-warning" @onclick="UpdateWinner">
                            <span class="btn-icon">💾</span> Update Winner
                        </button>

                        <button class="btn btn-lg btn-premium-secondary" @onclick="CancelEdit">
                            <span class="btn-icon">❌</span> Cancel
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-lg btn-premium-primary" @onclick="AddWinner">
                            <span class="btn-icon">➕</span> Add Winner
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PICK WINNER -->
<div class="card premium-card shadow-lg border-0 mb-4">
    <div class="card-header premium-header">
        <h5 class="mb-0">🎉 Pick Random Winner</h5>
    </div>

    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <input class="form-control form-control-lg premium-input" 
                       placeholder="Enter video code to pick winner..." 
                       @bind="pickCode" />
            </div>

            <div class="col-md-6 d-flex align-items-end">
                <button class="btn btn-lg btn-premium-success w-100" @onclick="PickWinner">
                    <span class="btn-icon">🎲</span> Pick Winner
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SEARCH & LOAD ACTIONS -->
<div class="card premium-card shadow-lg border-0 mb-4">
    <div class="card-header premium-header">
        <h5 class="mb-0">🔍 Search & Filter</h5>
    </div>

    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-4">
                <input class="form-control premium-input"
                       placeholder="Search by code..."
                       @bind="searchCode"
                       @oninput="FilterList" />
            </div>

            <div class="col-12">
                <div class="button-group d-flex flex-wrap gap-2">
                    <button class="btn btn-premium-secondary" @onclick="LoadWinnersByCode">
                        <span class="btn-icon">🔎</span> Search Code
                    </button>

                    <button class="btn btn-premium-secondary" @onclick="LoadAllWinners">
                        <span class="btn-icon">📋</span> Load All Winners
                    </button>

                    <button class="btn btn-premium-secondary" @onclick="LoadWinnerEntries">
                        <span class="btn-icon">🧾</span> Winner + Entry
                    </button>

                    <button class="btn btn-premium-secondary" @onclick="LoadAllWinnerEntries">
                        <span class="btn-icon">📚</span> All Winner Entries
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- WINNERS TABLE -->
@if (filteredWinners.Any())
{
    <div class="card premium-card shadow-lg border-0 mb-4">
        <div class="card-header premium-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">🏅 Winners List</h5>
                <span class="badge bg-light text-dark">@filteredWinners.Count</span>
            </div>
        </div>

        <div class="table-responsive premium-table-container">
            <table class="table premium-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Entry ID</th>
                        <th>Code</th>
                        <th>Draw Date</th>
                        <th>Status</th>
                        <th>Delete Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var w in filteredWinners)
                    {
                        <tr class="premium-row">
                            <td>
                                <code class="code-badge">@w.EntryId.ToString().Substring(0, 8)...</code>
                            </td>

                            <td>
                                <span class="badge bg-gradient-primary">@w.Code</span>
                            </td>

                            <td>
                                <span class="text-muted">@w.DrawDate.ToString("dd MMM yyyy")</span>
                            </td>

                            <td>
                                <span class="badge bg-info text-white">@w.Status</span>
                            </td>

                            <td>
                                <span class="status-badge @(w.SoftDelete == 0 ? "active" : "inactive")">
                                    @(w.SoftDelete == 0 ? "✓ Live" : "✗ Deleted")
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-icon-primary"
                                            title="Edit Winner"
                                            @onclick="() => EditWinner(w.Id)">
                                        ✏️
                                    </button>

                                    <button class="btn btn-sm btn-icon-danger"
                                            title="Soft Delete"
                                            @onclick="() => DeleteWinner(w.Id)">
                                        🗑
                                    </button>

                                    <button class="btn btn-sm btn-icon-dark-danger"
                                            title="Force Delete Permanently"
                                            @onclick="() => ForceDeleteWinner(w.Id)">
                                        💀
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- WINNER + ENTRY TABLE -->
@if (winnerEntryList.Any())
{
    <div class="card premium-card shadow-lg border-0">
        <div class="card-header premium-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">🧾 Winner + Entry Details</h5>
                <span class="badge bg-light text-dark">@winnerEntryList.Count</span>
            </div>
        </div>

        <div class="table-responsive premium-table-container">
            <table class="table premium-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Draw Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var w in winnerEntryList)
                    {
                        <tr class="premium-row">
                            <td>
                                <span class="badge bg-gradient-primary">@w.Code</span>
                            </td>

                            <td>
                                <span class="fw-semibold">@w.Name</span>
                            </td>

                            <td>
                                <a href="mailto:@w.Email" class="text-primary">@w.Email</a>
                            </td>

                            <td>
                                <span class="text-muted">@w.Phone</span>
                            </td>

                            <td>
                                <span class="text-muted">@w.DrawDate.ToString("dd MMM yyyy")</span>
                            </td>

                            <td>
                                <span class="status-badge @(w.SoftDelete == 0 ? "active" : "inactive")">
                                    @(w.SoftDelete == 0 ? "✓ Live" : "✗ Deleted")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {

    private string message = "";
    private string pickCode = "";
    private string searchCode = "";

    private bool editMode = false;

    private Winner winnerModel = new();
    private List<Winner> allWinners = new();
    private List<Winner> filteredWinners = new();

    private List<EntryDto> allEntries = new();
    private List<WinnerEntryDto> winnerEntryList = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await EntryApi.GetAllAsync(1, 5000);
        allEntries = result.Items.ToList();

        await LoadAllWinners();
    }

    private async Task LoadAllWinners()
    {
        allWinners = await WinnerApi.GetAllAsync();
        filteredWinners = allWinners.ToList();
    }

    private async Task LoadWinnersByCode()
    {
        if (string.IsNullOrWhiteSpace(searchCode))
            return;

        filteredWinners = await WinnerApi.GetWinnersByCodeAsync(searchCode);
    }

    private void FilterList()
    {
        filteredWinners = allWinners
            .Where(x => x.Code.Contains(searchCode, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task AddWinner()
    {
        if (winnerModel.DrawDate == DateTime.MinValue)
        {
            message = "Draw date is required!";
            return;
        }

        var ok = await WinnerApi.AddWinnerAsync(winnerModel);
        message = ok ? "✅ Winner added successfully!" : "❌ Failed to add winner";

        if (ok)
        {
            await LoadAllWinners();
            winnerModel = new();
        }
    }

    private async Task PickWinner()
    {
        if (string.IsNullOrWhiteSpace(pickCode))
        {
            message = "Please enter a video code!";
            return;
        }

        var result = await WinnerApi.PickWinnerAsync(pickCode);

        if (result != null)
        {
            message = $"✅ Winner picked! Entry ID: {result.EntryId}";
            await LoadAllWinners();
            pickCode = "";
        }
        else
            message = "❌ No valid entries found for this code!";
    }

    private async Task EditWinner(Guid id)
    {
        var w = await WinnerApi.GetWinnerByIdAsync(id);
        if (w == null) return;

        winnerModel = w;
        editMode = true;
    }

    private async Task UpdateWinner()
    {
        var ok = await WinnerApi.UpdateWinnerAsync(winnerModel);
        message = ok ? "✅ Winner updated successfully!" : "❌ Failed to update winner";

        if (ok)
        {
            editMode = false;
            winnerModel = new();
            await LoadAllWinners();
        }
    }

    private void CancelEdit()
    {
        editMode = false;
        winnerModel = new();
    }

    private async Task DeleteWinner(Guid id)
    {
        var ok = await WinnerApi.DeleteWinnerByIdAsync(id);

        if (ok)
        {
            allWinners.RemoveAll(x => x.Id == id);
            message = "✅ Winner soft deleted!";
        }
        else
            message = "❌ Failed to delete winner";

        filteredWinners = allWinners.ToList();
    }

    private async Task LoadWinnerEntries()
    {
        if (string.IsNullOrWhiteSpace(searchCode))
        {
            message = "Please enter a code to search!";
            return;
        }

        winnerEntryList = await WinnerApi.GetWinnerEntriesByCodeAsync(searchCode);
        message = winnerEntryList.Any() ? $"✅ Found {winnerEntryList.Count} entries" : "❌ No entries found";
    }

    private async Task LoadAllWinnerEntries()
    {
        winnerEntryList = await WinnerApi.GetAllWinnerEntriesAsync();
        message = $"✅ Loaded {winnerEntryList.Count} total winner entries";
    }

    private async Task ForceDeleteWinner(Guid id)
    {
        message = "🗑 Permanently deleting...";

        var ok = await WinnerApi.ForceDeleteWinnerAsync(id);

        if (ok)
        {
            allWinners.RemoveAll(x => x.Id == id);
            filteredWinners = allWinners.ToList();
            message = "✅ Winner permanently deleted!";
        }
        else
        {
            message = "❌ Force delete failed!";
        }
    }
}

