@page "/admin/participants"
@page "/admin/gifts/{GiftId:int}/participants"

@using SharedLib.Models
@using WASM.api
@using AffiGive_API_V1.Models

@inject IGiftApi GiftApi
@inject IUserApi UserApi
@inject NavigationManager Nav

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-5 fw-bold mb-2">👥 Gift Participants</h1>
            <p class="text-muted">Manage and view participants who joined this gift</p>
        </div>
        @if (GiftId.HasValue)
        {
            <button class="btn btn-lg btn-premium-primary" @onclick="() => ViewGiftDetails()">
                🎁 View Gift Details
            </button>
        }
    </div>
</div>

@if (participants == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-3">Loading participants...</p>
    </div>
}
else if (!participants.Any())
{
    <div class="card premium-card shadow-lg border-0">
        <div class="card-body p-5 text-center">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🚫</div>
            <h5 class="text-muted fw-semibold">No Participants Yet</h5>
            <p class="text-muted">No users have joined this gift yet</p>
        </div>
    </div>
}
else
{
    <div class="card premium-card shadow-lg border-0">
        <div class="card-header premium-header">
            <h5 class="mb-0">📋 Participants List</h5>
        </div>

        <div class="table-responsive premium-table-container">
            <table class="table premium-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>User</th>
                        <th>Joined At</th>
                        <th style="width: 100px; text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (item, index) in participants.Select((v, i) => (v, i + 1)))
                    {
                        <tr class="premium-row">
                            <td>
                                <span class="badge bg-gradient-primary">@index</span>
                            </td>

                            <td>
                                <button class="btn btn-link text-start p-0 user-link"
                                        @onclick="async () => await OpenUser(item.UserId, GiftId)">

                                    <div class="fw-semibold">
                                        @item.UserId
                                    </div>

                                    <div class="text-muted small">
                                        @(userMap.ContainsKey(item.UserId)
                                                                        ? userMap[item.UserId].Name
                                                                        : "Loading...")
                                    </div>

                                </button>
                            </td>

                            <td>
                                <span class="text-muted">@item.JoinedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </td>

                            <td class="text-center">
                                <button class="btn btn-sm btn-icon-danger"
                                        title="Delete Participant"
                                        @onclick="() => DeleteParticipant(item.UserId)">
                                    🗑
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<button class="btn btn-lg btn-premium-secondary mt-4" @onclick="GoBack">
    🔙 Back to Gifts
</button>

@* ===========================
   GIFT DETAILS MODAL
=========================== *@
@if (selectedGift != null || isGiftLoading)
{
    <div class="premium-modal-backdrop">
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content premium-modal">

                    <div class="modal-header premium-modal-header">
                        <h5 class="modal-title fw-bold">🎁 Gift Information</h5>
                        <button class="btn-close btn-close-white" @onclick="CloseGiftModal"></button>
                    </div>

                    <div class="modal-body">

                        @if (isGiftLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="text-muted mt-3">Loading gift details...</p>
                            </div>
                        }
                        else if (selectedGift != null)
                        {
                            <div class="row g-4">

                                <div class="col-md-4 text-center">
                                    @if (!string.IsNullOrWhiteSpace(selectedGift.Image))
                                    {
                                        <div class="gift-image-container mb-3">
                                            <img src="@selectedGift.Image"
                                                 class="rounded shadow"
                                                 style="width:120px;height:120px;object-fit:cover;border:4px solid #667eea" />
                                        </div>
                                    }

                                    <h6 class="fw-bold">@selectedGift.Provider</h6>

                                    <span class="badge @(selectedGift.IsActive ? "bg-gradient-primary" : "bg-danger") mt-2">
                                        @(selectedGift.IsActive ? "✓ Active" : "✗ Inactive")
                                    </span>
                                </div>

                                <div class="col-md-8">
                                    <div class="user-info">
                                        <div class="info-item mb-3">
                                            <label class="info-label">Prize Pool</label>
                                            <p class="info-value">@selectedGift.PrizePoolText</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Winners</label>
                                            <p class="info-value">@selectedGift.WinnerText</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Coins Required</label>
                                            <p class="info-value">@selectedGift.CoinsRequired</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Slots</label>
                                            <p class="info-value">@selectedGift.RemainingSlots / @selectedGift.TotalSlots</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Code</label>
                                            <p class="info-value"><code>@selectedGift.Code</code></p>
                                        </div>

                                        <div class="row">
                                            <div class="col-6">
                                                <div class="info-item">
                                                    <label class="info-label">From Date</label>
                                                    <p class="info-value">@selectedGift.FromDate.ToString("dd MMM yyyy")</p>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="info-item">
                                                    <label class="info-label">To Date</label>
                                                    <p class="info-value">@selectedGift.ToDate.ToString("dd MMM yyyy")</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Group ID</label>
                                            <p class="info-value">@selectedGift.GroupId</p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        }

                    </div>

                    <div class="modal-footer bg-light">

                        @if (selectedGift != null)
                        {
                            <button class="btn btn-danger"
                                    @onclick="SoftDeleteGift">
                                🗑 Soft Delete
                            </button>
                        }

                        <button class="btn btn-premium-secondary" @onclick="CloseGiftModal">
                            Close
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>
}

@* ===========================
   USER DETAILS MODAL
=========================== *@
@if (selectedUser != null || isUserLoading)
{
    <div class="premium-modal-backdrop">
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content premium-modal">

                    <div class="modal-header premium-modal-header">
                        <h5 class="modal-title fw-bold">👤 User Information</h5>
                        <button class="btn-close btn-close-white" @onclick="CloseModal"></button>
                    </div>

                    <div class="modal-body">

                        @if (isUserLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="text-muted mt-3">Loading user details...</p>
                            </div>
                        }
                        else if (selectedUser != null)
                        {
                            <div class="row g-4">

                                <div class="col-md-4 text-center">
                                    <div class="user-avatar mb-3">
                                        <img src="@selectedUser.ProfileImage"
                                             class="rounded-circle shadow"
                                             style="width:120px;height:120px;object-fit:cover;border:4px solid #667eea" />
                                    </div>

                                    <h6 class="fw-bold">@selectedUser.Name</h6>

                                    <span class="badge bg-gradient-primary mt-2">
                                        @selectedUser.AccountStatus
                                    </span>
                                </div>

                                <div class="col-md-8">
                                    <div class="user-info">
                                        <div class="info-item mb-3">
                                            <label class="info-label">User ID</label>
                                            <p class="info-value">@selectedUser.Id</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Email</label>
                                            <p class="info-value">@selectedUser.Email</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Phone</label>
                                            <p class="info-value">@selectedUser.Phone</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Nickname</label>
                                            <p class="info-value">@selectedUser.NickName</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Invite Code</label>
                                            <p class="info-value"><code>@selectedUser.InviteCode</code></p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Invited By</label>
                                            <p class="info-value">@selectedUser.InvitedByUserId</p>
                                        </div>

                                        <div class="info-item mb-3">
                                            <label class="info-label">Address</label>
                                            <p class="info-value text-wrap">@selectedUser.Address</p>
                                        </div>

                                        <div class="row">
                                            <div class="col-6">
                                                <div class="info-item">
                                                    <label class="info-label">Created</label>
                                                    <p class="info-value">@selectedUser.CreatedAt.ToString("dd MMM yyyy")</p>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="info-item">
                                                    <label class="info-label">Last Login</label>
                                                    <p class="info-value">@selectedUser.LastLogin.ToString("dd MMM yyyy HH:mm")</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        }

                    </div>

                    <div class="modal-footer bg-light">

                        @if (selectedUser != null)
                        {
                            <button class="btn btn-premium-primary"
                                    @onclick="GoToCoinHistory">
                                🪙 Coin History
                            </button>
                        }

                        <button class="btn btn-premium-secondary" @onclick="CloseModal">
                            Close
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public int? GiftId { get; set; }

    private List<GiftParticipation>? participants;
    private Dictionary<string, User> userMap = new();

    private User? selectedUser;
    private bool isUserLoading = false;

    private GiftMaster? selectedGift;
    private bool isGiftLoading = false;

    protected override async Task OnInitializedAsync()
    {
        // ⭐ Load participants
        if (GiftId.HasValue)
            participants = await GiftApi.GetParticipantsByGiftIdAsync(GiftId.Value);
        else
            participants = await GiftApi.GetAllParticipantsAsync();

        // ⭐ Load users for username display
        var users = await UserApi.GetAllUsersAsync();
        userMap = users.ToDictionary(u => u.Id.ToString(), u => u);
    }

    private void GoBack()
    {
        Nav.NavigateTo("/admin/gifts");
    }

    private async Task OpenUser(string userId, int? giftId)
    {
        isUserLoading = true;
        selectedUser = null;

        selectedUser = await UserApi.GetByUserId(userId);

        isUserLoading = false;
    }

    private void CloseModal()
    {
        selectedUser = null;
    }

    private void GoToCoinHistory()
    {
        if (selectedUser == null)
            return;

        // ⭐ Navigate to coin history page
        Nav.NavigateTo($"/admin/users/{selectedUser.Id}");
    }

    // ⭐ Gift Details Methods
    private async Task ViewGiftDetails()
    {
        if (!GiftId.HasValue)
            return;

        isGiftLoading = true;
        selectedGift = null;

        try
        {
            // Load gift details
            var allGifts = await GiftApi.GetAllAsync();
            selectedGift = allGifts?.FirstOrDefault(g => g.Id == GiftId.Value);
        }
        finally
        {
            isGiftLoading = false;
        }
    }

    private void CloseGiftModal()
    {
        selectedGift = null;
    }

    private async Task SoftDeleteGift()
    {
        if (selectedGift == null)
            return;

        // Soft delete the gift
        await GiftApi.DeleteAsync(selectedGift.Id);

        // Close modal and go back
        CloseGiftModal();
        GoBack();
    }

    // ⭐ Delete Participant
    private async Task DeleteParticipant(string userId)
    {
        if (!GiftId.HasValue)
            return;

        // Call API to remove participant
        await GiftApi.DeleteParticipantAsync(GiftId.Value, userId);

        // Reload participants list
        participants = await GiftApi.GetParticipantsByGiftIdAsync(GiftId.Value);
    }
}

